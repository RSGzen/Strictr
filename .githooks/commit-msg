#!/bin/sh
# Add the spec trailer derived from the branch name.
branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
id=$(printf '%s\n' "$branch" | sed -n 's#^[a-z]*/\([0-9][0-9][0-9]\)-.*#\1#p')
[ -n "$id" ] || exit 0
git interpret-trailers --in-place --if-exists=doNothing --trailer "Spec: $id" "$1"
