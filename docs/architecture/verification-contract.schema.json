{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RSGzen/Strictr/docs/architecture/verification-contract.schema.json",
  "title": "Strictr verification contract v1",
  "description": "Canonical machine-readable result of `strictr check`. Additional properties are allowed within schema version 1; consumers must tolerate additive fields.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "status",
    "scope",
    "tiers",
    "timings",
    "environment",
    "trust",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "status": {
      "enum": ["pass", "fail", "partial", "error"]
    },
    "scope": {
      "type": "object",
      "required": [
        "root",
        "targets",
        "files_checked",
        "files_skipped",
        "tests_collected",
        "tests_run",
        "tests_skipped"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_checked": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "tests_collected": {
          "type": "integer",
          "minimum": 0
        },
        "tests_run": {
          "type": "integer",
          "minimum": 0
        },
        "tests_skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "timings": {
      "type": "object",
      "required": ["total_ms"],
      "properties": {
        "total_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "platform", "root"],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "required": ["sandboxed", "warning"],
      "properties": {
        "sandboxed": {
          "const": false
        },
        "warning": {
          "const": "Local execution; not a security boundary."
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tier": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "tool",
        "duration_ms",
        "diagnostics",
        "skipped_reason",
        "meta"
      ],
      "properties": {
        "id": {
          "enum": ["tier0", "tier1-ruff", "tier1-types", "tier2-pytest"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "fail", "skipped", "error"]
        },
        "tool": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tool"
            }
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "skipped_reason": {
          "type": ["string", "null"]
        },
        "meta": {
          "type": "object"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["tier", "source", "path", "line", "column", "code", "severity", "message"],
      "properties": {
        "tier": {
          "enum": ["tier0", "tier1-ruff", "tier1-types", "tier2-pytest"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "end_column": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["error", "warning", "note"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "test": {
          "type": ["string", "null"]
        },
        "exception": {
          "type": ["string", "null"]
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
